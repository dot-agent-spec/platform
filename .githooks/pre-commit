#!/usr/bin/env bash
# pre-commit — run the governance gate before a commit is allowed to land.
#
# Wiring only, no check logic. To run the identical thing by hand without committing, use
# scripts/check.sh — which is also where the two shell fragments this repository declares off are
# declared, with their reasons. Both files export the same variable rather than sharing a sourced file:
# the sourced file was scripts/checks/_run.sh, whose three-branch runner resolution is exactly what broke
# and what this migration removed. `git grep VIBE_OPS_DISABLED_CHECKS` still finds every declaration in
# the workspace, which is the property that shape existed for.
#
# `set -e` is deliberately absent: the exit code is captured, never propagated by accident.
#
# SILENT ON SUCCESS. The expensive reader is not the terminal but the agent: a commit made through a tool
# call puts every printed line into a conversation, on every commit, forever. So a clean run says nothing
# and a failure says only what failed — not even the summary, which scripts/check.sh prints because it
# was asked for. GATE_VERBOSE=1 gets the full run back.
#
# To skip once: git commit --no-verify. Wired via `git config core.hooksPath .githooks` — local config
# that no clone inherits, which is also why an outside clone having no gate is not the gap it looks like:
# it never had one to lose.
set -uo pipefail

if ! command -v vibe-ops >/dev/null 2>&1; then
  echo "pre-commit: vibe-ops is not on PATH — the gate cannot run. Commit refused." >&2
  echo "Install it, or use --no-verify if you accept an unchecked commit." >&2
  exit 2
fi

ROOT=$(git rev-parse --show-toplevel)
cd "$ROOT" || exit 2

# See scripts/check.sh for why this is here and not in vibeops.config.ts: the shell fragments do not read
# the config at all. Keep the two copies in step; they are two lines and one grep finds both.
export VIBE_OPS_DISABLED_CHECKS="links:superseded by the markdown-link gate, which honours the dsl/ docs/ dogfood/ exclusions declared in vibeops.config.ts — this fragment has no population control and reports all three (2026-08-13)
budget:same finding the budget gate reports, where it is a warning with Track 6 named as its owner (2026-08-13)"

export NODE_OPTIONS="${NODE_OPTIONS:-} --no-warnings"

RC=0
for ops in check agents-md governance; do
  if [ "${GATE_VERBOSE:-}" = "1" ]; then
    vibe-ops "$ops" --verbose || RC=$?
  else
    OUT=$(vibe-ops "$ops" 2>&1) || RC=$?
    printf '%s\n' "$OUT" | grep -E '^(FAIL|WARN) ' || true
  fi
done

exit "$RC"
